   /**
    * f0 -> "new"
    * f1 -> "int"
    * f2 -> "["
    * f3 -> Expression()
    * f4 -> "]"
    */
   public R visit(ArrayAllocationExpression n, A argu) {
      R _ret=null;

      String code = BEGIN;

      String new_arr = gen_temp();

      String len = gen_temp();
      String org_len = gen_temp(); // afterwards we are making len = (len+1)*4
      //so for storing original length
      code += MOVE + len + " "; 
      
      System.out.println(code);code = "";
      n.f3.accept(this, argu);
      
      code += MOVE + org_len + len + "\n";
      code += MOVE+ len +  TIMES + PLUS + len + " 1 4\n";
      code += MOVE + new_arr + HALLOCATE + len + "\n" ; 
      
      // store length at position 0
      code += HSTORE + new_arr + " 0 " + org_len + "\n";

      String l0 = gen_label(),l1 = gen_label();
      String k = gen_temp();

      code += MOVE + k + " 4\n";
      code+=l0;
      code += CJUMP + LE + k + MINUS + len + " 1 "+ l1;
         code += HSTORE + PLUS + new_arr + k + "0 0\n";
         code += MOVE + k + PLUS + k + "4\n";
      code += JUMP + l0;

      code += l1 + NOOP;
      code += RETURN + new_arr+endl;
      code += END;
      System.out.println(code);

      return (R)INTARRAY;
   }

   /**
    * f0 -> "new"
    * f1 -> Identifier()
    * f2 -> "("
    * f3 -> ")"
    */
   public R visit(AllocationExpression n, A argu) {
      R _ret=null;
      
      ClassInfo c = classes.get(n.f1.f0.toString());
      Integer m_size = c.methods.size(),f_size = c.variables.size();
      m_size = m_size*4;
      f_size = f_size*4;

      String code = BEGIN;
      String new_obj = gen_temp();
      
      code += MOVE + new_obj + HALLOCATE+"8\n";

      String vtable = gen_temp();
      String fields = gen_temp();
      
      code += MOVE + vtable + HALLOCATE +(m_size).toString()+"\n";
      code += MOVE + fields + HALLOCATE + f_size.toString()+"\n";
      
      for(int i = 0;i<m_size/4;i++){
         Integer j = i*4;
         code += HSTORE + vtable + j.toString() + " "+ entry_to_label(c.methods.get(i))+"\n";
      }

      if(f_size != 0){
         String l1 = gen_label(),l0 = gen_label();
         String k = gen_temp();
         code += MOVE + k +" 0\n";
         f_size--;
         code += l0;
         code += CJUMP + LE + k + f_size +" "+l1;
            code += HSTORE + PLUS + fields + k + " 0 0 \n";
            code += MOVE + k + PLUS + k + " 4 \n";
         code += JUMP + l0;

         code += l1;
      }
      code += HSTORE + new_obj + "0 " + vtable +endl;
      code += HSTORE + new_obj + "4 " + fields + endl;
      code += RETURN + new_obj+'\n';
      code += END;
      System.out.print(code);

      // n.f0.accept(this, argu);
      // n.f1.accept(this, argu);
      // n.f2.accept(this, argu);
      // n.f3.accept(this, argu);
      return (R)n.f1.f0.toString();
   }

